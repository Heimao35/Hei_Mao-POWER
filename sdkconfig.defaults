# Opal ESP-TERMINAL internal RAM budget (see main/main.c LVGL DMA buffers)
#
# ~216 KiB internal heap: dual LVGL DMA draw buffers (~100 KiB), Wi-Fi static buffers,
# 32 KiB DMA reserve, FreeRTOS task stacks. PSRAM is 8 MiB; options below offload stacks.

# Wi-Fi STA only; Bluedroid not used (System menu Bluetooth entry is UI-only).
CONFIG_BT_ENABLED=n

# Large app task stacks (LVGL, net_wifi, pomodoro, led_rgb, ...) may use PSRAM.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Trim Wi-Fi buffers to save internal RAM (Wi-Fi/LWIP still prefer SPIRAM).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# Malloc smaller than 4 KiB uses internal; larger blocks use PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
